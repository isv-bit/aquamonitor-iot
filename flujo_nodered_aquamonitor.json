 {
  "id": "fn_separar",
  "type": "function",
  "z": "tab_aqua",
  "name": "Separar variables y alertas",
  "func": "const d = msg.payload;\nif (typeof d !== \"object\" || d === null) return null;\n\n// 1 y 2: valores para medidores y graficas\nconst nivel = { payload: d.nivel, topic: \"Nivel (%)\" };\nconst temp  = { payload: d.temperatura, topic: \"Temperatura (°C)\" };\n\n// 3: estado de la bomba (confirmado por el ESP32)\nconst bomba = { payload: d.bomba === \"ON\" ? \"🟢 ENCENDIDA\" : \"⚪ APAGADA\" };\n\n// 4: tabla con las ultimas 10 mediciones\nlet filas = flow.get(\"filas\") || [];\nfilas.unshift({\n    \"Hora\": new Date().toLocaleTimeString(\"es-CO\"),\n    \"Nivel (%)\": d.nivel,\n    \"Temperatura (°C)\": d.temperatura,\n    \"Bomba\": d.bomba\n});\nfilas = filas.slice(0, 10);\nflow.set(\"filas\", filas);\nconst tabla = { payload: filas };\n\n// 5: alertas segun los umbrales del proyecto\nconst alertas = [];\nif (d.nivel < 10)       alertas.push(\"⛔ Nivel CRÍTICO (< 10 %)\");\nelse if (d.nivel < 20)  alertas.push(\"⚠️ Nivel bajo (< 20 %): encienda la bomba\");\nelse if (d.nivel > 95)  alertas.push(\"⚠️ Riesgo de desbordamiento (> 95 %): apague la bomba\");\nif (d.temperatura > 25)      alertas.push(\"🌡️ Agua tibia (> 25 °C)\");\nelse if (d.temperatura < 10) alertas.push(\"❓ Temperatura inusual (< 10 °C)\");\nconst alerta = { payload: alertas.length ? alertas.join(\"  |  \") : \"✅ Condiciones normales\" };\n\nreturn [nivel, temp, bomba, tabla, alerta];",
  "outputs": 5,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 420,
  "y": 200,
  "wires": [
   [
    "g_nivel",
    "c_nivel"
   ],
   [
    "g_temp",
    "c_temp"
   ],
   [
    "t_bomba"
   ],
   [
    "tbl_med"
   ],
   [
    "t_alerta"
   ]
  ]
 },
